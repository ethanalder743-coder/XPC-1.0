# Your Discord user ID. This account controls Premium codes, grants and bypasses.
BOT_OWNER_ID=
# Optional checkout/payment page shown by /premium.
PREMIUM_PAYMENT_URL=
# Shared key accepted by /premiumunlock. Set the real value in Railway only.
PREMIUM_ACCESS_KEY=

